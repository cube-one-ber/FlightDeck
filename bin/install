#!/bin/sh
# Builds and installs the package, starts the service, and links the bar
# widget into Omarchy's plugin directory. Add it to the bar afterwards with
# `omarchy bar put io.github.cube-one-ber.flightdeck`.
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
cd "$ROOT/pkgbuild"
makepkg -fsi

systemctl --user daemon-reload
systemctl --user enable --now flightdeck.service
systemctl --user restart flightdeck.service

PLUGIN_DIR="$HOME/.config/omarchy/plugins"
PLUGIN_TARGET="$PLUGIN_DIR/io.github.cube-one-ber.flightdeck"
LEGACY_LINK="$PLUGIN_DIR/flightdeck.bar"

mkdir -p "$PLUGIN_DIR"
if [ -L "$LEGACY_LINK" ] && [ "$(readlink -- "$LEGACY_LINK")" = "/usr/share/flightdeck/widget" ]; then
  rm -f "$LEGACY_LINK"
fi
if [ -L "$PLUGIN_TARGET" ] && [ "$(readlink -- "$PLUGIN_TARGET")" = "/usr/share/flightdeck" ]; then
  :
elif [ ! -e "$PLUGIN_TARGET" ] && [ ! -L "$PLUGIN_TARGET" ]; then
  ln -s /usr/share/flightdeck "$PLUGIN_TARGET"
else
  echo "Keeping existing plugin at $PLUGIN_TARGET (not replacing user-managed checkout or link)." >&2
fi
